---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    title: 'General Contracting',
    desc: 'Full project management from ground up. We coordinate every trade, keep the schedule, and deliver on budget.',
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-2 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>`,
  },
  {
    title: 'Roofing',
    desc: 'Commercial and residential roofing. Installations, replacements, and repairs using premium materials.',
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>`,
  },
  {
    title: 'Concrete & Foundation',
    desc: 'Foundations, flatwork, driveways, and structural concrete. Built to spec and built to last.',
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"/></svg>`,
  },
  {
    title: 'Remodeling',
    desc: 'Interior and exterior renovations. Kitchens, bathrooms, additions, and full gut rehabs.',
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z"/></svg>`,
  },
  {
    title: 'Framing & Structural',
    desc: 'Wood and steel framing for new construction and additions. Engineered for strength.',
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>`,
  },
  {
    title: 'Site Work & Excavation',
    desc: 'Land clearing, grading, utilities, and site prep. We get the job ready before a single nail is driven.',
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/></svg>`,
  },
];
---

<Layout title="Heritage Build Group — Quality Construction">
  <!-- Hero -->
  <section class="min-h-screen bg-[#111111] flex items-center relative overflow-hidden">
    <!-- Subtle grid pattern -->
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(#F5F5F3 1px, transparent 1px), linear-gradient(90deg, #F5F5F3 1px, transparent 1px); background-size: 60px 60px;"></div>
    <div class="relative max-w-6xl mx-auto px-6 py-32 pt-40">
      <div class="max-w-3xl">
        <p class="text-[#A1A1AA] text-sm font-semibold uppercase tracking-widest mb-6">Heritage Build Group</p>
        <h1 class="text-5xl sm:text-6xl lg:text-7xl font-black text-[#F5F5F3] leading-none tracking-tight mb-6">
          Built Right.<br />
          <span class="text-[#A1A1AA]">Built to Last.</span>
        </h1>
        <p class="text-[#A1A1AA] text-lg sm:text-xl max-w-xl leading-relaxed mb-10">
          Full-service construction for commercial and residential projects. From the foundation up, we deliver quality craftsmanship on time and on budget.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="#contact" class="bg-[#F5F5F3] hover:bg-white text-[#111111] font-bold px-8 py-4 text-sm uppercase tracking-wide transition-colors text-center">
            Get a Free Quote
          </a>
          <a href="#services" class="border border-[#A1A1AA]/40 hover:border-[#F5F5F3] text-[#F5F5F3] font-bold px-8 py-4 text-sm uppercase tracking-wide transition-colors text-center">
            Our Services
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats bar -->
  <section class="bg-[#F5F5F3] border-b border-[#111111]/10">
    <div class="max-w-6xl mx-auto px-6 py-10">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        {[
          { value: '15+', label: 'Years in Business' },
          { value: '500+', label: 'Projects Completed' },
          { value: '100%', label: 'Licensed & Insured' },
          { value: '5★', label: 'Client Satisfaction' },
        ].map(stat => (
          <div class="text-center">
            <div class="text-3xl font-black text-[#111111]">{stat.value}</div>
            <div class="text-sm text-[#A1A1AA] font-medium mt-1">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="bg-[#F5F5F3] py-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="mb-14">
        <p class="text-[#A1A1AA] text-xs font-bold uppercase tracking-widest mb-3">What We Do</p>
        <h2 class="text-4xl font-black text-[#111111] tracking-tight">Our Services</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {services.map(service => (
          <div class="bg-white border border-[#111111]/10 p-7 hover:border-[#111111]/30 transition-colors group">
            <div class="text-[#A1A1AA] mb-4 group-hover:text-[#111111] transition-colors" set:html={service.icon} />
            <h3 class="text-[#111111] font-bold text-base mb-2">{service.title}</h3>
            <p class="text-[#A1A1AA] text-sm leading-relaxed">{service.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section id="projects" class="bg-[#111111] py-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="mb-14">
        <p class="text-[#A1A1AA] text-xs font-bold uppercase tracking-widest mb-3">Our Work</p>
        <h2 class="text-4xl font-black text-[#F5F5F3] tracking-tight">Recent Projects</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {[
          { title: 'Commercial Office Build-Out', type: 'General Contracting', location: 'Downtown' },
          { title: 'Residential New Construction', type: 'Full Build', location: 'Suburban' },
          { title: 'Industrial Roofing Replacement', type: 'Roofing', location: 'Warehouse District' },
          { title: 'Multi-Unit Foundation Work', type: 'Concrete & Foundation', location: 'East Side' },
          { title: 'Kitchen & Bath Remodel', type: 'Remodeling', location: 'Midtown' },
          { title: 'Retail Center Site Work', type: 'Site Work & Excavation', location: 'North End' },
        ].map(project => (
          <div class="bg-[#1a1a1a] border border-white/10 overflow-hidden group hover:border-white/20 transition-colors">
            <div class="bg-[#222] h-48 flex items-center justify-center">
              <svg class="w-12 h-12 text-[#A1A1AA]/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
            </div>
            <div class="p-5">
              <p class="text-[#A1A1AA] text-xs font-semibold uppercase tracking-wide mb-1">{project.type}</p>
              <h3 class="text-[#F5F5F3] font-bold text-sm">{project.title}</h3>
              <p class="text-[#A1A1AA]/60 text-xs mt-1">{project.location}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="bg-[#F5F5F3] py-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <p class="text-[#A1A1AA] text-xs font-bold uppercase tracking-widest mb-3">Who We Are</p>
          <h2 class="text-4xl font-black text-[#111111] tracking-tight mb-6">Heritage Built on Quality</h2>
          <p class="text-[#A1A1AA] leading-relaxed mb-4">
            Heritage Build Group has been delivering exceptional construction services for over 15 years. We handle everything from small renovations to large commercial projects with the same commitment to quality and detail.
          </p>
          <p class="text-[#A1A1AA] leading-relaxed mb-8">
            We're fully licensed, bonded, and insured — and we stand behind every project we build. No shortcuts, no surprises. Just honest work and clear communication from start to finish.
          </p>
          <div class="space-y-3">
            {['Licensed & Insured', 'On-Time Delivery', 'Transparent Pricing', 'Dedicated Project Management'].map(item => (
              <div class="flex items-center gap-3">
                <div class="w-5 h-5 bg-[#111111] flex items-center justify-center shrink-0">
                  <svg class="w-3 h-3 text-[#F5F5F3]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                  </svg>
                </div>
                <span class="text-[#111111] font-medium text-sm">{item}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="bg-[#111111] h-96 flex items-center justify-center">
          <svg class="w-16 h-16 text-[#A1A1AA]/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact / Quote Form -->
  <section id="contact" class="bg-[#111111] py-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
        <div>
          <p class="text-[#A1A1AA] text-xs font-bold uppercase tracking-widest mb-3">Start Your Project</p>
          <h2 class="text-4xl font-black text-[#F5F5F3] tracking-tight mb-6">Get a Free Quote</h2>
          <p class="text-[#A1A1AA] leading-relaxed mb-8">
            Tell us about your project and we'll get back to you within 24 hours with a free estimate.
          </p>
          <div class="space-y-4 text-sm">
            <div class="flex items-center gap-3 text-[#A1A1AA]">
              <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              <a href="mailto:scott@heritagebuildgroup.com" class="hover:text-[#F5F5F3] transition-colors">scott@heritagebuildgroup.com</a>
            </div>
          </div>
        </div>

        <!-- Netlify form -->
        <form
          name="quote"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="space-y-4"
        >
          <input type="hidden" name="form-name" value="quote" />
          <p class="hidden"><input name="bot-field" /></p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-[#A1A1AA] text-xs font-semibold uppercase tracking-wide mb-2">First Name</label>
              <input type="text" name="first_name" required
                class="w-full bg-[#1a1a1a] border border-white/10 focus:border-[#A1A1AA] text-[#F5F5F3] text-sm px-4 py-3 outline-none transition-colors placeholder:text-[#A1A1AA]/40"
                placeholder="John" />
            </div>
            <div>
              <label class="block text-[#A1A1AA] text-xs font-semibold uppercase tracking-wide mb-2">Last Name</label>
              <input type="text" name="last_name" required
                class="w-full bg-[#1a1a1a] border border-white/10 focus:border-[#A1A1AA] text-[#F5F5F3] text-sm px-4 py-3 outline-none transition-colors placeholder:text-[#A1A1AA]/40"
                placeholder="Smith" />
            </div>
          </div>

          <div>
            <label class="block text-[#A1A1AA] text-xs font-semibold uppercase tracking-wide mb-2">Email</label>
            <input type="email" name="email" required
              class="w-full bg-[#1a1a1a] border border-white/10 focus:border-[#A1A1AA] text-[#F5F5F3] text-sm px-4 py-3 outline-none transition-colors placeholder:text-[#A1A1AA]/40"
              placeholder="john@example.com" />
          </div>

          <div>
            <label class="block text-[#A1A1AA] text-xs font-semibold uppercase tracking-wide mb-2">Phone</label>
            <input type="tel" name="phone"
              class="w-full bg-[#1a1a1a] border border-white/10 focus:border-[#A1A1AA] text-[#F5F5F3] text-sm px-4 py-3 outline-none transition-colors placeholder:text-[#A1A1AA]/40"
              placeholder="(555) 000-0000" />
          </div>

          <div>
            <label class="block text-[#A1A1AA] text-xs font-semibold uppercase tracking-wide mb-2">Service Needed</label>
            <select name="service" required
              class="w-full bg-[#1a1a1a] border border-white/10 focus:border-[#A1A1AA] text-[#F5F5F3] text-sm px-4 py-3 outline-none transition-colors">
              <option value="">Select a service...</option>
              <option>General Contracting</option>
              <option>Roofing</option>
              <option>Concrete & Foundation</option>
              <option>Remodeling</option>
              <option>Framing & Structural</option>
              <option>Site Work & Excavation</option>
              <option>Other</option>
            </select>
          </div>

          <div>
            <label class="block text-[#A1A1AA] text-xs font-semibold uppercase tracking-wide mb-2">Project Details</label>
            <textarea name="message" rows="4" required
              class="w-full bg-[#1a1a1a] border border-white/10 focus:border-[#A1A1AA] text-[#F5F5F3] text-sm px-4 py-3 outline-none transition-colors placeholder:text-[#A1A1AA]/40 resize-none"
              placeholder="Tell us about your project, timeline, and any specific requirements..."></textarea>
          </div>

          <button type="submit"
            class="w-full bg-[#F5F5F3] hover:bg-white text-[#111111] font-bold text-sm uppercase tracking-wide py-4 transition-colors">
            Submit Quote Request →
          </button>
        </form>
      </div>
    </div>
  </section>
</Layout>
